# 目标平台 ARM64 虚拟平台(官方推荐，替代armvirt)
CONFIG_TARGET_armsr=y
CONFIG_TARGET_armsr_armv8=y
CONFIG_TARGET_armsr_armv8_DEVICE_generic=y
CONFIG_LIBC="musl"
CONFIG_INIT_PROCD=y

# 文件系统：仅输出 ext4 可写镜像
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=512
CONFIG_TARGET_ROOTFS_SQUASHFS=n
CONFIG_TARGET_ROOTFS_TARGZ=n
CONFIG_TARGET_IMAGES_GZIP=n

# 编译加速 & 瘦身
CONFIG_CCACHE=y
CONFIG_BUILD_LOG=n
CONFIG_DEBUG=n
CONFIG_DEBUG_INFO=n
CONFIG_KERNEL_DEBUG=n
CONFIG_SIGNATURE_CHECK=n
CONFIG_USE_STRIP=y
CONFIG_OPTIMIZE_FOR_SIZE=y

# ========== 彻底禁用内核相关（解决内核编译报错） ==========
CONFIG_TARGET_KERNEL_PARTSIZE=0
CONFIG_ALL_KMODS=n
CONFIG_ALL_NONSHARED=n
CONFIG_KERNEL_MODULES=n
CONFIG_TARGET_UBOOT=n

# ========== 关闭所有硬件驱动（容器无用） ==========
CONFIG_WIRELESS=n
CONFIG_USB=n
CONFIG_BLK_DEV_SD=n
CONFIG_ATA=n
CONFIG_PCI=n
CONFIG_NVME_CORE=n
CONFIG_VIDEO=n
CONFIG_SOUND=n
CONFIG_HID=n
CONFIG_INPUT=n
CONFIG_RTC=n

# 关闭文档、多语言
CONFIG_BUILD_DOCS=n
CONFIG_INCLUDE_LOCALES=n
CONFIG_LUCI_LANG_en=y

# ========== 基础系统 ==========
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_opkg=y

# ========== iStoreOS 核心组件（必须保留） ==========
CONFIG_PACKAGE_luci-app-istorex=y
CONFIG_PACKAGE_luci-app-linkease=y

# ========== 屏蔽冲突包（消除lxc依赖警告） ==========
CONFIG_PACKAGE_lxc=n
CONFIG_PACKAGE_lxc-utils=n
CONFIG_PACKAGE_lxcfs=n

# 精简多余插件
CONFIG_PACKAGE_ping=n
CONFIG_PACKAGE_wget=n
CONFIG_PACKAGE_curl=n
CONFIG_PACKAGE_luci-app-quickstart=n
CONFIG_PACKAGE_luci-app-unishare=n
CONFIG_PACKAGE_luci-app-diskman=n
CONFIG_PACKAGE_luci-app-ddnsto=n
CONFIG_PACKAGE_luci-theme-argon=n
CONFIG_PACKAGE_luci-app-samba=n